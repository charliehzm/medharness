# MedHarness INT-5b §D.1 relay dev env
# Synthetic 0-PHI dev-only values. Do not use in production.
#
# model-router server_v2.py does not expose a direct allowlist path env such as
# MODEL_ALLOWLIST_PATH or MODEL_ROUTER_ALLOWLIST. It resolves allowlists as:
#   $CLAUDE_PROJECT_DIR/openspec/changes/<change_id>/MODEL_ALLOWLIST.json
# Mount deploy/dev/model_allowlist.dev.json as /config/model_allowlist.dev.json,
# then copy/symlink it to the resolved change path for the synthetic change id,
# or inject it with server_v2.py inject_allowlist in a local-only dev harness.
#
# The §D.1 new-api middleware service URL envs are:
#   PHI_DETECTOR_URL=http://phi-detector:9000
#   DESENSITIZE_URL=http://desensitize:9000
#   MODEL_ROUTER_URL=http://model-router:9000
#   INJECTION_URL=http://prompt-injection-scan:9000
#   OUTBOUND_SAFETY_URL=http://outbound-safety:9000
#
# A clean synthetic gpt-4o route must be signed with MODEL_ROUTER_TIER_SECRET,
# include desensitized=true, and include a non-empty caller_vendor_family so
# heterogeneity does not fail closed.
CLAUDE_PROJECT_DIR=/config
ALLOWLIST_INJECT_TOKEN=dev-int5b-allowlist-inject
MODEL_ROUTER_TIER_SECRET=dev-int5b-secret
SESSION_SECRET=dev-int5b
PHI_DETECTOR_URL=http://phi-detector:9000
DESENSITIZE_URL=http://desensitize:9000
MODEL_ROUTER_URL=http://model-router:9000
INJECTION_URL=http://prompt-injection-scan:9000
OUTBOUND_SAFETY_URL=http://outbound-safety:9000
